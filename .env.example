# Supabase connection. Copy this file to .env.local (git-ignored) and fill in the key.
# Without both values the app falls back to local mock data.
#
# URL: Supabase dashboard > Project Settings > API. Not secret.
VITE_SUPABASE_URL=https://rzwxphhgzjdlnililhbr.supabase.co
# Anon / public key: Project Settings > API Keys. NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=your-anon-key
